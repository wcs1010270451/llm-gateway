{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Gin Server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/server",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "env": {
        "APP_ENV": "development",
        "HTTP_ADDR": "127.0.0.1:3212",
        "DATABASE_URL": "postgres://aeuser:aeuser123@127.0.0.1:5432/llm_gateway?sslmode=disable",
        "AUTH_TOKEN_SECRET": "change-me-in-development",
        "PROVIDER_KEY_SECRET": "change-me-provider-key-secret",
        "FRONTEND_ORIGIN": "http://127.0.0.1:3213,http://localhost:3213",
        "GIN_TRUSTED_PROXIES": "127.0.0.1"
      }
    },
    {
      "name": "Frontend: Vite Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend",
      "env": {
        "VITE_API_BASE_URL": "http://127.0.0.1:3212"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Backend + Frontend",
      "configurations": [
        "Backend: Gin Server",
        "Frontend: Vite Dev Server"
      ],
      "stopAll": true
    }
  ]
}
