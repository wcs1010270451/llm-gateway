# 域名与公网入口
DOMAIN=api.example.com
FRONTEND_ORIGIN=https://api.example.com
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443

# 运行环境
APP_ENV=production
GIN_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# 数据库
POSTGRES_USER=llm_gateway
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=llm_gateway

# 应用登录密钥
# 用于签名登录 token，建议使用 32 字符以上随机字符串。
AUTH_TOKEN_SECRET=replace-with-a-long-random-auth-secret

# 供应商密钥加密密钥
# 用于解密上游供应商 Key，正式使用后不要随意修改。
PROVIDER_KEY_SECRET=replace-with-a-long-random-provider-key-secret

# VertexAI ADC 凭证
# 宿主机路径会挂载到后端容器内的 /secrets/gcp-credentials.json。
GCP_CREDENTIALS_FILE=/secrets/gcp-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-credentials.json

# owner_claude_max 供应商（Claude Max 订阅）凭证目录
# 该宿主机目录会以只读方式挂载到后端容器的 /secrets/claude。
# 目录里需有 .credentials.json，且对容器用户(uid 65532)可读。
# 因为 claude CLI 写出的凭证是 600 权限、且每次刷新会重写文件，
# 建议由 8 小时定时任务在刷新后暂存一份只读副本到这里，例如：
#   claude --print ping && install -m 644 -D ~/.claude/.credentials.json /srv/claude-creds/.credentials.json
CLAUDE_CREDENTIALS_DIR=/srv/claude-creds

# 请求/响应体短期日志
# docker compose 会把该目录映射到持久化 volume。
LOG_BODY_DIR=/var/lib/llm-gateway/request-log-bodies
LOG_BODY_RETENTION_DAYS=7
