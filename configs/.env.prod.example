# 域名与公网入口
DOMAIN=api.example.com
FRONTEND_ORIGIN=https://api.example.com
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443

# 运行环境
APP_ENV=production
GIN_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# 数据库
POSTGRES_USER=llm_gateway
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=llm_gateway

# 应用登录密钥
# 用于签名登录 token，建议使用 32 字符以上随机字符串。
AUTH_TOKEN_SECRET=replace-with-a-long-random-auth-secret

# 供应商密钥加密密钥
# 用于解密上游供应商 Key，正式使用后不要随意修改。
PROVIDER_KEY_SECRET=replace-with-a-long-random-provider-key-secret

# VertexAI ADC 凭证
# 宿主机路径会挂载到后端容器内的 /secrets/gcp-credentials.json。
GCP_CREDENTIALS_FILE=/secrets/gcp-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-credentials.json
