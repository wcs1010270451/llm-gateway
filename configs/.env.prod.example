# Domain
DOMAIN=api.example.com
FRONTEND_ORIGIN=https://api.example.com
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Runtime
APP_ENV=production
GIN_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# Database
POSTGRES_USER=llm_gateway
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=llm_gateway

# Auth secrets
# 建议使用 32 字符以上随机字符串。正式使用后不要修改 PROVIDER_KEY_SECRET，
# 否则已经保存的上游供应商密钥会无法解密。
AUTH_TOKEN_SECRET=replace-with-a-long-random-auth-secret
PROVIDER_KEY_SECRET=replace-with-a-long-random-provider-key-secret

# Frontend build
# 留空表示前端同源调用 /api 和 /v1，由 Caddy/Nginx 反代到后端。
VITE_API_BASE_URL=

# VertexAI ADC
# 和 WcsTransfer 保持一致：宿主机放这个文件，容器内固定读取 /secrets/gcp-credentials.json。
GCP_CREDENTIALS_FILE=/secrets/gcp-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-credentials.json
